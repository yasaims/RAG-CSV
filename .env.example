# このファイルを .env にコピーして使う（.env は git 管理しない）。
# 各項目はコメントアウトされた既定値。変更したいものだけコメントを外す。
# 定義元・詳細は docs/configuration.md を参照。

# SAFETY_QA_CSV_PATH=AI/data/accidents.csv
# SAFETY_QA_ACCIDENTS_DB_PATH=var/accidents.duckdb
# SAFETY_QA_QUERIES_DB_PATH=var/queries.duckdb

# SAFETY_QA_EMBEDDING_MODEL_NAME=cl-nagoya/ruri-v3-130m
# SAFETY_QA_EMBEDDING_DIM=512
# SAFETY_QA_PRELOAD_EMBEDDER=false

# 開発時、CSV 未変更のまま再起動を速くしたい場合に true にする。
SAFETY_QA_SKIP_ETL=true

# SAFETY_QA_OLLAMA_HOST=http://localhost:11434
# SAFETY_QA_OLLAMA_MODEL=hf.co/unsloth/Qwen3-4B-Instruct-2507-GGUF:latest
# SAFETY_QA_OLLAMA_NUM_THREAD=4
# SAFETY_QA_OLLAMA_TIMEOUT_SECONDS=60.0
# SAFETY_QA_OLLAMA_NUM_CTX=8192
# SAFETY_QA_OLLAMA_KEEP_ALIVE=30m

# SAFETY_QA_TOP_N=5
# SAFETY_QA_MAX_CONCURRENT_ANSWERS=1

# SAFETY_QA_BUSINESS_TIMEZONE=Asia/Tokyo

# ローカル開発では console にすると人間可読な色付きログになる。
# SAFETY_QA_LOG_LEVEL=INFO
SAFETY_QA_LOG_FORMAT=console
# SAFETY_QA_SERVICE_NAME=safety-qa
# SAFETY_QA_ENVIRONMENT=local

# 信頼できるプロキシ（ALB 等）配下でのみ true にする。
# SAFETY_QA_TRUST_INBOUND_TRACE_HEADER=false
